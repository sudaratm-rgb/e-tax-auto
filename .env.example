# ===== PEAK Open API credentials =====
# ขอจากเมนู Settings > API ใน PEAK
PEAK_BASE_URL=https://api.peakaccount.com/api/v1

# connectId ใช้เป็น Secret Key ในการเซ็น Time-Signature (HMAC-SHA1)
PEAK_CONNECT_ID=your_connect_id_here

# Token ที่ PEAK ออกให้
PEAK_USER_TOKEN=your_user_token_here

# connectKey (= Password จาก PEAK) ใช้ mint/refresh Client-Token อัตโนมัติ
PEAK_CONNECT_KEY=your_connect_key_here

# Client-Token เริ่มต้น (ไม่จำเป็น — ระบบ mint ใหม่เองจาก connectKey เพราะ token หมดอายุได้)
PEAK_CLIENT_TOKEN=

# จำนวน thread ดึง contact พร้อมกัน (PEAK contact API ช้า ~5s/call)
CONTACT_FETCH_WORKERS=12

# ===== PostgreSQL audit trail (ไม่บังคับ) =====
# เก็บประวัติผลตรวจใบเสร็จ (receipt_checks) + ประวัติการส่ง/callback (send_log/etax_callbacks)
# คู่ขนานกับไฟล์ .jsonl เดิม — ใช้เปิดดูผ่าน DBeaver ได้ ถ้าไม่ตั้งค่านี้ แอปทำงานได้ปกติ
# เหมือนเดิม แค่ไม่มี audit trail ใน DB (จะ log warning เฉย ๆ ไม่กระทบการทำงานหลัก)
# สร้างตารางเองอัตโนมัติจาก db/schema.sql ตอนเริ่มใช้งานครั้งแรก (หรือรัน schema.sql เองผ่าน
# DBeaver ล่วงหน้าก็ได้)
DATABASE_URL=postgres://user:password@localhost:5432/etax

# ===== ค่า default สำหรับการส่ง e-tax =====
# etaxConnectType: ชนิดการเชื่อมต่อผู้ให้บริการ e-Tax — ทดสอบแล้ว: 2 = ผ่าน INET (1 ทำให้ resCode 500)
ETAX_CONNECT_TYPE=2
# isUpdateDocument: 1 = อัปเดตเอกสารเดิม, 0 = ไม่อัปเดต
ETAX_IS_UPDATE_DOCUMENT=0

# callback URL (public) ให้ PEAK/INET ยิง "ผลออกใบจริง" แบบ async กลับมา
# - localhost รับไม่ได้ ต้อง deploy ให้มี public URL ก่อน แล้วชี้มาที่ /api/etax-callback
# - ทดสอบดู payload ได้ด้วย webhook.site: ใช้ "endpoint URL" ไม่ใช่ลิงก์หน้า view
#   เช่น https://webhook.site/0b8a450b-e47d-4435-a627-57f2c982d73d
ETAX_CALLBACK_URL=https://your-deployed-domain.example.com/api/etax-callback

# ===== mapping ประเภท contact (PEAK ส่ง type มาเป็น integer) =====
# จากข้อมูลจริง: type 5 = บุคคลธรรมดา, type 2,3 = นิติบุคคล (ใส่ได้หลายค่า คั่นด้วย ,)
# 5=บุคคลธรรมดา (ที่อยู่ 1 ฟิลด์พอ, ไม่ต้อง taxid)
CONTACT_TYPES_INDIVIDUAL=5
# 2=บริษัท 3=บมจ. (ที่อยู่ครบ + ต้องมี taxid)
CONTACT_TYPES_FULL_TAX=2,3
# 1=หจก. 4=ร้านค้า 6=คณะบุคคล 7=อื่นๆ 8=หสน. 9=มูลนิธิ 10=สมาคม 11=ร่วมค้า (ที่อยู่ครบ ไม่ต้อง taxid)
CONTACT_TYPES_FULL_NOTAX=1,4,6,7,8,9,10,11
